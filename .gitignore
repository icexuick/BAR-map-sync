.env
*.zip

# Heightmaps live in Webflow CMS — only the placements.json files need to
# go to GitHub for jsDelivr. The PNGs stay local for viewer/map.html.
maps_features/**/*.png

# Python bytecode cache
__pycache__/
*.pyc

# Temp work dirs from the feature extraction pipeline
temp_features_extract/
temp_features_extract_map/
*.sd7

# IDE
.vscode/

# Log files from extraction / sync runs
*.log

# Locally-saved texture sets (extract_map_textures.py output)
maps_textures/

# Raw map files cache (local-only, never push to git)
maps_files/
